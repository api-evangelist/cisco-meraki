                "value": "",
                "type": "path",
                "description": "Serial"
              },
              {
                "name": "startTimestamp",
                "value": "",
                "type": "query",
                "description": "The start time for the clip. The timestamp is expected to be in ISO 8601 format."
              },
              {
                "name": "endTimestamp",
                "value": "",
                "type": "query",
                "description": "The end time for the clip. The timestamp is expected to be in ISO 8601 format."
              },
              {
                "name": "imagerId",
                "value": "",
                "type": "query",
                "description": "The imager ID to query. Required for multi-imager cameras (must be between 1 and the imager count). For single-imager cameras, must be omitted or set to 0."
              }
            ]
          },
          "docs": "Generate a video clip of up to 5 minutes long."
        },
