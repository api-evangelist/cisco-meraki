{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cisco Meraki Dashboard API — spaces",
    "version": "1.72.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Cisco-Meraki-API-Key",
      "value": "{{X-Cisco-Meraki-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "spaces",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the status of the Spaces integration in Meraki",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.meraki.com/{basePath}/organizations/:organizationId/spaces/integrate/status",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "Organization ID"
              }
            ]
          },
          "docs": "Get the status of the Spaces integration in Meraki"
        },
        {
          "info": {
            "name": "Remove the Spaces integration from Meraki",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.meraki.com/{basePath}/organizations/:organizationId/spaces/integration/remove",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "path",
                "description": "Organization ID"
              }
            ]
          },
          "docs": "Remove the Spaces integration from Meraki"
        }
      ]
    }
  ],
  "bundled": true
}